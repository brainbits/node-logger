{
    "name": "@brainbits/node-logger-monorepo",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "description": "Logger for node projects",
    "repository": {
        "type": "git",
        "url": "git@github.com:brainbits/node-logger.git"
    },
    "workspaces": [
        "packages/node-logger",
        "packages/node-logger-formatter-monolog",
        "packages/node-logger-plugin-sentry"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "typecheck": "tsc",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "release": "sh scripts/release.sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.0.4",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.12.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4"
    }
}
