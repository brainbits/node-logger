{
    "name": "@brainbits/node-logger-monorepo",
    "version": "2.5.1",
    "private": true,
    "type": "module",
    "description": "Logger for node projects",
    "repository": {
        "type": "git",
        "url": "git@github.com:brainbits/node-logger.git"
    },
    "workspaces": [
        "packages/node-logger",
        "packages/node-logger-formatter-monolog",
        "packages/node-logger-plugin-sentry"
    ],
    "scripts": {
        "build": "npm run build --workspaces",
        "typecheck": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "release": "sh scripts/release.sh"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.0.4",
        "typescript": "~6.0.3",
        "vitest": "^5.0.4"
    }
}
